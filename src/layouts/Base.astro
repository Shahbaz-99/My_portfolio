---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string }
const { title, description = `${site.name}, ${site.role}. ${site.headline}` } = Astro.props;
const full = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          <a href="/#projects">Projects</a>
          <a href="/#experience">Experience</a>
          <a href="/#ai">AI</a>
          <a href="/architecture">How this site is built</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>{site.name}, {site.location}</span>
        <span>Static site on Cloudflare Pages. <a href="/architecture">See the architecture</a>.</span>
      </footer>
    </div>
  </body>
</html>
