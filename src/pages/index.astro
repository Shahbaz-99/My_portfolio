---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import { site, projects, timeline, skills, aiWork } from '../data/site';
const stack = skills.flatMap((s) => s.items).join(', ');
---
<Base>
  <section id="top" class="hero">
    <div class="polaroid">
      {site.photo ? <img src={site.photo} alt={`Portrait of ${site.name}`} width="76" height="76" /> : <span class="ph" aria-hidden="true">{site.initials}</span>}
    </div>
    <div class="greet">
      <h1 class="hello">{site.name.split(' ')[0]} here!</h1>
      <span class="clock" data-clock-wrap aria-hidden="true"><span data-clock={site.timezone}></span> {site.tzLabel}</span>
    </div>
    <p>A backend engineer building REST APIs with Django and turning messy requirements into reliable, well-documented services.</p>
    <p>Currently interning at {timeline[0].name}, where I ship Dockerized APIs to Linux servers. Learning AI engineering and Kubernetes next.</p>
    <p>Most of my code lives on <a class="wavy" href={site.github}>GitHub</a>.</p>
    <div class="chips">
      <a class="chip" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
      {site.linkedin && <a class="chip" href={site.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>}
      <a class="chip" href={site.github} aria-label="GitHub"><Icon name="code" /></a>
      {site.resumeUrl && <a class="chip" href={site.resumeUrl} aria-label="Resume (PDF)"><Icon name="file" /></a>}
    </div>
  </section>

  <section id="projects" class="block" aria-labelledby="h-projects">
    <h2 class="label" id="h-projects">Best projects</h2>
    <div class="cards">{projects.map((p, i) => <ProjectCard p={p} i={i} />)}</div>
    <GitHubActivity />
  </section>

  <section id="about" class="block" aria-labelledby="h-exp">
    <h2 class="label" id="h-exp">Experience</h2>
    <ul class="tl">
      {timeline.map((t) => (
        <li>
          <span class="mono" aria-hidden="true">{t.mono}</span>
          <div>
            <div class="top">
              <span class="name">{t.url ? <a class="wavy" href={t.url}>{t.name}</a> : t.name}</span>
              <span class="when">{t.when}</span>
            </div>
            <div class="role">{t.role}</div>
            <p>{t.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="meta">Stack: {stack}</p>
  </section>

  <section id="ai" class="block" aria-labelledby="h-ai">
    <h2 class="label" id="h-ai">AI work</h2>
    {aiWork.length === 0 ? (
      <p class="empty">I am adding AI engineering to my backend work. Projects will appear here as I ship them, each with source and a write-up.</p>
    ) : (
      <ul class="list">
        {aiWork.map((a) => (
          <li>
            <div class="line">{a.href ? <a href={a.href}>{a.title} {'\u2197'}</a> : <span>{a.title}</span>}</div>
            <p class="desc">{a.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
