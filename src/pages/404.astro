---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page not found">
  <section class="hero">
    <h1 class="hello">Lost?</h1>
    <p>That page doesn't exist. <a class="wavy" href={base}>Head back home</a>.</p>
  </section>
</Base>
