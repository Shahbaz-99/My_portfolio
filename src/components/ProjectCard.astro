---
import type { Project } from '../data/site';
import Cover from './Cover.astro';
const { p, i = 0 } = Astro.props as { p: Project; i?: number };
---
<a class="card reveal" href={`/projects/${p.slug}`} style={`--h:${(i * 130 + 250) % 360};--d:${i}`}>
  <Cover p={p} i={i} />
  <div class="cap">
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <p class="meta">{p.stack.join(', ')}</p>
    <span class="go">View case study <i aria-hidden="true">→</i></span>
  </div>
</a>
