---
import type { Project } from '../data/site';
const { p, i = 0 } = Astro.props as { p: Project; i?: number };
const href = p.problem ? `/projects/${p.slug}` : (p.demo ?? p.repo);
const widths = [[70, 52, 62], [58, 74, 46], [66, 44, 72]][i % 3];
const Tag = href ? 'a' : 'article';
---
<Tag class="card" href={href} style={`--h:${(i * 130 + 250) % 360}`}>
  <div class="cover">
    {p.year && <span class="year">{p.year}</span>}
    <div class="mock" aria-hidden="true">
      <b></b>
      {widths.map((w) => <div class="mrow"><i style={`width:${w}%`}></i><em></em></div>)}
    </div>
  </div>
  <div class="cap">
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <p class="meta">{p.stack.join(', ')}</p>
  </div>
</Tag>
