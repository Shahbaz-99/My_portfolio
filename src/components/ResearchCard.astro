---
import type { Research } from '../data/site';
import ResearchCover from './ResearchCover.astro';
const { r, i = 0 } = Astro.props as { r: Research; i?: number };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<a class="card reveal" href={`${base}research/${r.slug}`} style={`--h:165;--d:${i}`}>
  <ResearchCover slug={r.slug} badge={r.kind} />
  <div class="cap">
    <h3>{r.title}</h3>
    <p>{r.summary}</p>
    <p class="meta">{r.org}. {r.tags.join(', ')}</p>
    <span class="go">Read the research <i aria-hidden="true">→</i></span>
  </div>
</a>
