---
const { slug, large = false, badge } = Astro.props as { slug: string; large?: boolean; badge?: string };
let seed = 11;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const f = (n: number) => n.toFixed(1);
const scattered = Array.from({ length: 44 }, (_, k) => ({ x: 24 + rnd() * 116, y: 36 + rnd() * 100, g: k % 2 === 0 }));
const tight = Array.from({ length: 44 }, (_, k) =>
  k % 2 === 0
    ? { x: 262 + rnd() * 26, y: 62 + rnd() * 52, g: true }
    : { x: 188 + rnd() * 26, y: 62 + rnd() * 52, g: false },
);
const dot = (g: boolean) => (g ? 'hsl(145 55% 42%)' : 'hsl(0 65% 55%)');
---
<div class={`cover${large ? ' lg' : ''}`} style={`view-transition-name: cover-research-${slug}`}>
  {badge && <span class="badge">{badge}</span>}
  <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect x="12" y="22" width="140" height="136" rx="8" fill="var(--panel)" opacity=".7" />
    <rect x="168" y="22" width="140" height="136" rx="8" fill="var(--panel)" opacity=".7" />
    <line x1="82" y1="30" x2="82" y2="150" stroke="var(--muted)" stroke-dasharray="3 3" opacity=".6" />
    <line x1="238" y1="30" x2="238" y2="150" stroke="var(--muted)" stroke-dasharray="3 3" opacity=".6" />
    {scattered.map((d) => <circle cx={f(d.x)} cy={f(d.y)} r="3" fill={dot(d.g)} opacity=".8" />)}
    {tight.map((d) => <circle cx={f(d.x)} cy={f(d.y)} r="3" fill={dot(d.g)} opacity=".8" />)}
    <text x="82" y="170" text-anchor="middle" font-size="9" fill="var(--muted)">Model A</text>
    <text x="238" y="170" text-anchor="middle" font-size="9" fill="var(--muted)">Model B</text>
  </svg>
</div>
